# Oil Spill Intelligence System Environment Configuration

# Application
APP_NAME="Oil Spill Intelligence System"
APP_ENV="development"
DEBUG=true
LOG_LEVEL="INFO"
SECRET_KEY="dev-secret-key-change-in-production"
DATA_MODE="REAL"  # Options: REAL, DEMO

# Server
DATA_MODE="DEMO" # "DEMO" or "REAL"
HOST="0.0.0.0"
PORT=8000

# Database
# PostGIS PostgreSQL URL (e.g. postgresql://postgres:postgres@localhost:5432/oil_spill_intel)
# Default is a local SQLite database for zero-credential development
DATABASE_URL="sqlite:///./data/oil_spill_intelligence.db"

# Satellite Ingestion (Copernicus Data Space Ecosystem)
CDSE_CLIENT_ID=""
CDSE_CLIENT_SECRET=""
CDSE_API_URL="https://catalogue.dataspace.copernicus.eu/resto/api"

# Oceanographic Data (Copernicus Marine Service - CMEMS)
CMEMS_USERNAME=""
CMEMS_PASSWORD=""

# Meteorological Data (ECMWF CDS / NOAA GFS)
CDS_API_KEY=""
CDS_API_URL="https://cds.climate.copernicus.eu/api/v2"

# External Asset Layers
WDPA_API_KEY=""
GLOBAL_FISHING_WATCH_API_KEY=""

# OSIRIS Maritime Intelligence
OSIRIS_ENABLED=true
OSIRIS_BASE_URL="https://osirisai.live"
OSIRIS_TIMEOUT_SECONDS=10

# AI Assistant
LLM_PROVIDER="local_heuristic" # Options: "local_heuristic", "openai", "gemini"
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# ML & Computation
DEVICE="cpu" # "cuda" or "cpu"
MODEL_CHECKPOINT_DIR="./ml/experiments/checkpoints"
DEFAULT_SEGMENTATION_MODEL="deeplabv3plus"
BATCH_SIZE=8
TILE_SIZE=256
TILE_OVERLAP=32

# Trajectory Forecasting
DEFAULT_ENSEMBLE_SIZE=50
FORECAST_HORIZONS_HOURS=[6, 12, 24, 48]
